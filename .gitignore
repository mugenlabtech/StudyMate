
# ==========================================
# StudyMate V1.0 — .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/versions

# Next.js
/.next/
/out/
/build/
/dist/

# Production
/.vercel
/.netlify

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# API keys and credentials
*.pem
*.key
*.p12
*.pfx
*.secret
secrets/
credentials.json
service-account*.json

# Supabase local development
/supabase/.branches
/supabase/.temp
/supabase/.profiles
/supabase/.env
/supabase/.env.*

# Supabase generated files
/supabase/.cache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing and coverage
/coverage/
/test-results/
/playwright-report/
/blob-report/
.nyc_output/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Temporary uploads and recordings
/tmp/
/temp/
/uploads/
/recordings/
/transcriptions-temp/
/processing-temp/

# Generated media
/generated-audio/
/generated-video/
/render-output/
/remotion-output/

# Local databases
*.sqlite
*.sqlite3
*.db

# Cache
.cache/
.turbo/
.parcel-cache/
.eslintcache

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Backup files
*.bak
*.backup
*.old
*.swp
*.swo

# Local archives
*.zip
*.tar
*.tar.gz

# Local-only notes
notes.local.*
